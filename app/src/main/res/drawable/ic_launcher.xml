<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy launcher drawable for Android 6 and 7. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="108dp" android:height="108dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_background" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:width="108dp" android:height="108dp">
        <bitmap android:src="@drawable/browser_emblem" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
