<resources>
    <style name="BaseBrowserTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorAccent">@color/browser_accent</item>
        <item name="android:colorAccent">@color/browser_accent</item>
        <item name="android:statusBarColor">@color/browser_paper</item>
        <item name="android:navigationBarColor">@color/browser_paper</item>
        <item name="android:windowLightStatusBar">@bool/browser_light_bars</item>
        <item name="android:textColorPrimary">@color/browser_ink</item>
        <item name="android:textColorSecondary">@color/browser_hint</item>
        <item name="android:alertDialogTheme">@style/BrowserAlertTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/browser_surface</item>
    </style>
    <style name="AppTheme" parent="BaseBrowserTheme" />
    <style name="BrowserAlertTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/browser_accent</item>
        <item name="android:textColorPrimary">@color/browser_ink</item>
        <item name="android:textColorSecondary">@color/browser_hint</item>
        <item name="android:colorBackground">@color/browser_surface</item>
    </style>
</resources>
